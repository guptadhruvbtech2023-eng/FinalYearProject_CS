# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# LLM API Configuration (Optional)
# If provided, the AI Assistant and Insight Generator can connect to OpenAI / Gemini API.
# If not provided, the application uses its built-in Statistical NLP Business Analyst engine
# which guarantees zero crashes and zero hallucinations based on actual data calculations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Data Storage
DATA_DIR=uploads
MODELS_DIR=models_cache
REPORTS_DIR=reports
